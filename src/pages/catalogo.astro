---
// @ts-nocheck
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import productos from "../data/productos.json";

// Reutilizamos nuestro archivo data/productos.json tomando los 4 cursos principales
// (Para probar el Requisito 6 de arreglo vacío, cambia temporalmente esta línea por: const cursos = [];)
const cursos = productos.filter((p) => p.disponible).slice(0, 4);
---
{/* Reto 2: Catálogo de cursos conectado a los datos de Guía Académica */}
<Layout>
  <Header />

  <main class="contenedor-catalogo">
    <header class="encabezado-catalogo">
      <h1>Catálogo Detallado de Programas y Sílabos</h1>
      <p>Explora los módulos, temas y ficha técnica de nuestras especialidades en Guía Académica.</p>
    </header>

    {/* Requisito 6: Mensaje "Pronto más cursos" si el arreglo está vacío */}
    {cursos.length === 0 ? (
      <p class="vacio">Pronto más cursos</p>
    ) : (
      <div class="lista-cursos">
        {cursos.map((curso) => {
          // Requisito 2: Etiqueta dinámica (h2 si es destacado, h3 si no)
          const EtiquetaTitulo = curso.destacado ? "h2" : "h3";

          return (
            <article class="curso-detalle">
              <div class="cabecera-curso">
                <EtiquetaTitulo class="titulo-curso">
                  {curso.nombre}
                </EtiquetaTitulo>
                {curso.destacado && <span class="badge-destacado">Destacado</span>}
              </div>

              {/* Requisito 5: Descripción con <Fragment set:html> */}
              <div class="descripcion-html">
                <Fragment set:html={curso.descripcion} />
              </div>

              {/* Requisito 4: Ficha técnica en <dl> (nivel, horas, módulos) usando fragmentos */}
              <dl class="ficha-tecnica">
                <>
                  <dt>Nivel:</dt>
                  <dd>{curso.nivel}</dd>
                </>
                <>
                  <dt>Horas:</dt>
                  <dd>{curso.horas} horas académicas</dd>
                </>
                <>
                  <dt>Módulos:</dt>
                  <dd>{curso.modulos.length} módulos</dd>
                </>
              </dl>

              {/* Requisito 3: Lista anidada de módulos y temas con dos map() */}
              <div class="temario">
                <h4>Estructura de Módulos y Temas:</h4>
                <ol class="lista-modulos">
                  {curso.modulos.map((mod) => (
                    <li>
                      <strong>{mod.titulo}</strong>
                      <ul class="lista-temas">
                        {mod.temas.map((tema) => (
                          <li>{tema}</li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ol>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .contenedor-catalogo {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem;
  }
  .encabezado-catalogo {
    margin-bottom: 2rem;
    border-bottom: 3px solid #71e7b6;
    padding-bottom: 1rem;
  }
  .encabezado-catalogo h1 {
    color: #013366;
    margin: 0 0 0.5rem 0;
  }
  .lista-cursos {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .curso-detalle {
    background: #ffffff;
    border-radius: 10px;
    padding: 1.8rem;
    box-shadow: 0 4px 12px rgba(1, 51, 102, 0.08);
    border-left: 6px solid #013366;
  }
  .cabecera-curso {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .titulo-curso {
    color: #013366;
    margin: 0;
  }
  .badge-destacado {
    background-color: #ffd700;
    color: #013366;
    font-weight: bold;
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .descripcion-html {
    color: #4a5568;
    line-height: 1.6;
    margin: 0.8rem 0;
  }
  .ficha-tecnica {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.8rem;
    background-color: #f4f4f4;
    padding: 1rem;
    border-radius: 8px;
    margin: 1rem 0;
  }
  .ficha-tecnica dt {
    font-weight: bold;
    color: #013366;
    font-size: 0.85rem;
    text-transform: uppercase;
  }
  .ficha-tecnica dd {
    margin: 0 0 0.5rem 0;
    color: #1a202c;
    font-weight: 600;
  }
  .temario h4 {
    color: #013366;
    margin: 1rem 0 0.5rem 0;
  }
  .lista-modulos {
    margin: 0;
    padding-left: 1.2rem;
    color: #013366;
  }
  .lista-modulos > li {
    margin-bottom: 0.8rem;
  }
  .lista-temas {
    margin-top: 0.4rem;
    padding-left: 1.2rem;
    color: #4a5568;
  }
  .vacio {
    background: #fff3cd;
    color: #856404;
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
    font-weight: bold;
  }
</style>