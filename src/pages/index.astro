---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import Footer from "../components/Footer.astro";
import productos from "../data/productos.json";
import Layout from '../layouts/Layout.astro';
const serviciosDisponibles = productos.filter((p) => p.disponible);
---
<Layout>
	<Header />
    <Hero />

    <main id="servicios">
      <h2>Nuestros Servicios Académicos y Psicométricos</h2>
      <p class="subtitulo">
        Contamos con{" "}
        <strong>{serviciosDisponibles.length}</strong>{" "}
        servicios activos para acompañarte en tu investigación.
      </p>

      <section class="grilla">
        {serviciosDisponibles.map((item) => (
          <Card
            nombre={item.nombre}
            categoria={item.categoria}
            precio={item.precio}
            nuevo={item.nuevo}
            descripcion={item.descripcion}
            imagen={item.imagen}
          />
        ))}
      </section>
    </main>

    <Footer />
</Layout>
